# Agent Code Library — gitignore

# Index database (auto-rebuilt)
.acl/index/
.acl/dist/

# Python
__pycache__/
*.pyc
*.pyo
.env

# SQLite journal files (auto-created by sqlite)
*.db
*.db-journal
*.db-shm
*.db-wal

# OS files
.DS_Store
Thumbs.db

# Sandbox executor audit logs (local-only)
.acl/audit/*.json
